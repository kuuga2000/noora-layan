{% import 'components.noora.macros' as ui %}
{% if component.enabled is not defined or component.enabled %}
{% set selected_categories = component.categories is iterable ? component.categories : [] %}
{% set category_entries = [] %}
{% for category in selected_categories %}
    {% set category_url = ui.url(category.url)|trim %}
    {% if category_url %}
        {% set category_entries = category_entries|merge([{'name': category.name|default(''), 'url': category_url, 'image': category.image|default('')}]) %}
    {% endif %}
{% endfor %}
{% if not category_entries|length %}
    {% set category_entries = [
        {'name': language.code == 'ar' ? 'وصل حديثاً' : 'New arrivals', 'url': link('latest-products'), 'image': ''},
        {'name': language.code == 'ar' ? 'الأكثر مبيعاً' : 'Best sellers', 'url': link('most-sales-products'), 'image': ''},
        {'name': language.code == 'ar' ? 'العروض المختارة' : 'Selected offers', 'url': link('offers'), 'image': ''},
        {'name': language.code == 'ar' ? 'اكتشفي العلامات' : 'Discover brands', 'url': link('brands'), 'image': ''}
    ] %}
{% endif %}
<section component-id="{{ componentId }}" class="nl-section nl-categories nl-container" aria-labelledby="nl-categories-{{ position }}">
    <div class="nl-section-heading nl-section-heading--center">
        {% if component.eyebrow %}<p class="nl-eyebrow">{{ ui.text(component.eyebrow, language.code) }}</p>{% endif %}
        <h2 class="nl-heading" id="nl-categories-{{ position }}">{{ ui.text(component.title, language.code) }}</h2>
    </div>
    <div class="nl-categories__grid">
        {% for category in category_entries %}
            <a class="nl-category nl-category--ready" href="{{ category.url|e('html_attr') }}">
                <div class="nl-category__image">
                    {% if category.image %}<img src="{{ category.image|e('html_attr') }}" width="480" height="600" loading="lazy" decoding="async" alt="">{% else %}<i class="sicon-image" aria-hidden="true"></i>{% endif %}
                </div>
                <span class="nl-category__label"><span>{{ category.name|e }}</span><i class="sicon-arrow-left nl-arrow" aria-hidden="true"></i></span>
            </a>
        {% endfor %}
    </div>
</section>
{% endif %}
