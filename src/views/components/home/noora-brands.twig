{% import 'components.noora.macros' as ui %}
{% if (component.enabled is not defined or component.enabled) and component.brands|length %}
<section component-id="{{ componentId }}" class="nl-section nl-brands nl-container" aria-labelledby="nl-brands-{{ position }}">
    <div class="nl-section-heading nl-section-heading--center">
        {% if component.eyebrow %}<p class="nl-eyebrow">{{ ui.text(component.eyebrow, language.code) }}</p>{% endif %}
        <h2 class="nl-heading" id="nl-brands-{{ position }}">{{ ui.text(component.title, language.code) }}</h2>
    </div>
    <div class="nl-brands__grid">
        {% for brand in component.brands %}
            {% set brand_url = ui.url(brand.url)|trim %}
            {% if brand_url %}<a class="nl-brand" href="{{ brand_url|e('html_attr') }}" aria-label="{{ brand.name|e('html_attr') }}">
                {% if brand.logo %}<img src="{{ brand.logo|e('html_attr') }}" alt="{{ brand.name|e('html_attr') }}" width="240" height="100" loading="lazy" decoding="async">{% else %}<span>{{ brand.name|e }}</span>{% endif %}
            </a>{% endif %}
        {% endfor %}
    </div>
</section>
{% endif %}
